# Backend penerbitan e-SKPT — jangan masukkan credential ke file ini.
# Salin menjadi .env hanya pada server backend tepercaya.

SKPT_STORAGE_PROVIDER=GOOGLE_DRIVE
GOOGLE_DRIVE_SKPT_FOLDER_ID=1q0k68owb_9tLiPlUlu6orwvcIaTlkpM7
GOOGLE_DRIVE_SKPT_FOLDER_URL=https://drive.google.com/drive/folders/1q0k68owb_9tLiPlUlu6orwvcIaTlkpM7

# Pengecualian sementara disetujui 29-10-2026. Folder masih My Drive pribadi
# dan memiliki izin "anyone with the link: writer". Konfigurasi ini bukan
# persetujuan keamanan permanen dan wajib dimigrasikan ke server Pemkab.
GOOGLE_DRIVE_SKPT_ENVIRONMENT=TEMPORARY_ACTIVE
GOOGLE_DRIVE_REQUIRE_PRIVATE_FOLDER=false
GOOGLE_DRIVE_TEMPORARY_PERMISSION_EXCEPTION=true
GOOGLE_DRIVE_MIGRATION_TARGET=PEMKAB_SERVER

SKPT_PDF_MAX_BYTES=10485760
SKPT_HASH_ALGORITHM=SHA-256
SKPT_PUBLIC_DIRECT_DRIVE_LINKS=false

# Isi hanya di secret manager/environment backend, jangan commit nilainya.
GOOGLE_APPLICATION_CREDENTIALS=

# URL origin frontend yang diizinkan mengakses backend, pisahkan dengan koma.
ALLOWED_ORIGINS=https://e-skpt.web.app
PORT=8080
