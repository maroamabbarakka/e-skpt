{
  "firestore": {"rules": "firestore.rules", "indexes": "firestore.indexes.json"},
  "emulators": {"firestore": {"host": "127.0.0.1", "port": 8081}},
  "hosting": {
    "site": "e-skpt",
    "public": "dist",
    "cleanUrls": true,
    "ignore": ["firebase.json", ".firebaserc", "firestore.rules", "firestore.indexes.json", ".git/**", ".firebase/**", "node_modules/**", "*.md"],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}
      ]},
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]},
      {"source": "**/*.{css,js,woff2,ttf,webp,png,jpg,svg}", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]}
    ]
  }
}
